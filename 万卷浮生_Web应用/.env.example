# Floating Scrolls server environment

# Required in production. Generate a long random value; never commit the real value.
JWT_SECRET=replace_with_a_long_random_value

# Network and persistence
HOST=127.0.0.1
PORT=8888
DB_PATH=./data.db

# Optional comma-separated browser origins for a separately hosted frontend.
# Same-origin production deployments can leave this empty.
CORS_ORIGIN=

# AI defaults. AI features work only when the selected provider has a valid key.
AI_PROVIDER=deepseek
AI_MODEL=

DEEPSEEK_API_KEY=
ZHIPU_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
MINIMAX_API_KEY=
DOUBAO_API_KEY=
STEPFUN_API_KEY=
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MIMO_API_KEY=
BAIDU_API_KEY=
TENCENT_API_KEY=

# Ollama usually runs locally and may not require a key.
OLLAMA_API_KEY=
